def heapify(a, n, i):
    m = i
    l = 2 * i + 1
    r = 2 * i + 2
    
    if l < n and a[l] > a[m]:
        m = l
        
    if r < n and a[r] > a[m]:
        m = r
        
    if m != i:
        a[i], a[m] = a[m], a[i]
        heapify(a, n, m)

def h_sort(a):
    n = len(a)
    
    for i in range(n // 2 - 1, -1, -1):
        heapify(a, n, i)
        
    for i in range(n - 1, 0, -1):
        a[i], a[0] = a[0], a[i]
        heapify(a, i, 0)
        
    return a

d = [64, 34, 25, 12, 22, 11, 90]
print(h_sort(d.copy()))
