w = [2, 3, 4, 5]
val = [3, 4, 5, 6]
W = 3
n = len(w)
dp = [[0 for _ in range(W + 1)] for _ in range(n + 1)]

for i in range(n + 1):
    for j in range(W + 1):
        if (i==0 or j==0):
            dp[i][j] = 0
        else:
            pick = 0
            not_pick = dp[i-1][j]
            if (w[i-1] <= j):
                pick = val[i-1] + dp[i-1][j-w[i-1]]
            dp[i][j] = max(pick, not_pick)

print(dp[n][W])
