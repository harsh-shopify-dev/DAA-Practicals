import time

def f_iter(n):
    r = 1
    for i in range(1, n + 1):
        r = r * i
    return r

def f_rec(n):
    if n == 0 or n == 1:
        return 1
    return n * f_rec(n - 1)

num = 500

t1 = time.time()
ans1 = f_iter(num)
print("Iterative time:", time.time() - t1)

t2 = time.time()
ans2 = f_rec(num)
print("Recursive time:", time.time() - t2)
